<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sp="clr-namespace:NINA.ShellyPower"
                    xmlns:view="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
                    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer">

    <!--
      Templates du plugin Shelly Power, compiles en BAML (contenu diffe).
      Charge via PluginResources (export MEF officiel) : NINA fusionne ce dictionnaire
      dans Application.Current.Resources.MergedDictionaries au chargement du plugin.
    -->

    <!-- Panneau dockable de la fenetre principale (GenericTemplateSelector : FullName + "_Dockable") -->
    <DataTemplate x:Key="NINA.ShellyPower.ShellyOptionsVM_Dockable">
        <sp:ShellyOptionsView/>
    </DataTemplate>


    <!-- Page Plugins des Options de NINA (PluginOptionsDataTemplateSelector : manifest.Name + suffixe) -->
    <DataTemplate x:Key="Shelly Power_Options">
        <sp:ShellyOptionsView/>
    </DataTemplate>
    <DataTemplate x:Key="Shelly PowerOptions">
        <sp:ShellyOptionsView/>
    </DataTemplate>
    <DataTemplate x:Key="ShellyOptionsVM_Options">
        <sp:ShellyOptionsView/>
    </DataTemplate>

    <!--
      Editeurs des instructions de sequencer — pattern officiel NINA (identique a
      SetSwitchValue) : le DataTemplate implicite (DataType) enveloppe l'editeur dans un
      NOUVEAU SequenceBlockView dont la propriete SequenceItemContent recoit les
      controles. Ce blockview interne fournit TOUS les boutons d'action de NINA
      (delete, disable, menu, move) autour de l'editeur personnalise.
    -->
    <DataTemplate DataType="{x:Type sp:ShellyPowerOnInstruction}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="ON" FontWeight="Bold" Foreground="#FF66BB6A"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox MinWidth="140" MaxWidth="320" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                              ToolTip="Prise à piloter (les prises configurées avec une IP apparaissent ici)"/>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type sp:ShellyPowerOffInstruction}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="OFF" FontWeight="Bold" Foreground="#FFEF5350"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox MinWidth="140" MaxWidth="320" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                              ToolTip="Prise à piloter (les prises configurées avec une IP apparaissent ici)"/>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!-- Editeur de l'instruction "Attendre etat" : prise + etat attendu + delai max -->
    <DataTemplate DataType="{x:Type sp:ShellyPowerWaitInstruction}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Prise :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="140" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                              ToolTip="Prise à surveiller"/>
                    <ComboBox Width="90" VerticalAlignment="Center" Margin="8,0,0,0"
                              SelectedIndex="{Binding ExpectedOnIndex, Mode=TwoWay}"
                              ToolTip="Etat attendu">
                        <ComboBoxItem Content="OFF"/>
                        <ComboBoxItem Content="ON"/>
                    </ComboBox>
                    <TextBlock Text="Délai (s) :" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Width="60" VerticalAlignment="Center"
                             Text="{Binding TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!--
      Editeur de l'instruction "Toggle + duree" : bascule la prise, attend la duree
      configuree, puis revient a l'etat initial.
    -->
    <DataTemplate DataType="{x:Type sp:ShellyPowerToggleInstruction}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Prise :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="140" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                              ToolTip="Prise à basculer"/>
                    <TextBlock Text="Durée (min) :" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Width="50" VerticalAlignment="Center"
                             Text="{Binding DurationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!--
      Editeur de l'instruction "Extinction differee executee par la prise" : le minuteur
      tourne DANS LA PRISE (RPC toggle_after) — le PC qui a envoye la commande peut
      s'eteindre avant l'echeance. Ne pas confondre avec Toggle+Waiting : ici la durree
      tourne sur la prise, pas dans NINA.
    -->
    <DataTemplate DataType="{x:Type sp:ShellyPowerDelayedOffInstruction}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Prise :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="140" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                              ToolTip="Prise a eteindre (extinction executee par la prise elle-meme)"/>
                    <TextBlock Text="Delai (s) :" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Width="60" VerticalAlignment="Center"
                             Text="{Binding DelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="La prise s'eteindra toute seule apres ce delai (le PC peut etre arrete avant)"/>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>
    <!--
      Editeur de la condition "Shelly Power While" : le bloc s'execute TANT QUE la prise
      est dans l'etat choisi (interrupt via ConditionWatchdog des que l'etat change).
    -->
    <DataTemplate DataType="{x:Type sp:ShellyPowerCondition}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Prise :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="140" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                              ToolTip="Prise à surveiller"/>
                    <ComboBox Width="90" VerticalAlignment="Center" Margin="8,0,0,0"
                              SelectedIndex="{Binding ExpectedOnIndex, Mode=TwoWay}"
                              ToolTip="Le bloc s'exécute tant que la prise est dans cet état">
                        <ComboBoxItem Content="OFF"/>
                        <ComboBoxItem Content="ON"/>
                    </ComboBox>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!-- Variantes cles "_Mini" pour le mini-sequenceur (MiniSequencerDataTemplateSelector) -->
    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerOnInstruction_Mini">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="ON" FontWeight="Bold" Foreground="#FF66BB6A"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox MinWidth="120" VerticalAlignment="Center"
                      ItemsSource="{Binding PlugNames}"
                      SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                      ToolTip="Prise à piloter (les prises configurées avec une IP apparaissent ici)"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerOffInstruction_Mini">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="OFF" FontWeight="Bold" Foreground="#FFEF5350"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox MinWidth="120" VerticalAlignment="Center"
                      ItemsSource="{Binding PlugNames}"
                      SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                      ToolTip="Prise à piloter (les prises configurées avec une IP apparaissent ici)"/>
        </StackPanel>
    </DataTemplate>

    <!--
      Editeur du declencheur "Shelly Power Unsafe" : selection de la prise a couper
      automatiquement quand le safety monitor passe en UNSAFE. Pattern ReconnectTrigger
      (SequenceBlockView + SequenceItemContent). Les instructions imbriquees dans le
      declencheur s'executent apres la coupure (TriggerRunner standard de NINA).
    -->
    <DataTemplate DataType="{x:Type sp:ShellyPowerUnsafeTrigger}">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="⚠ Unsafe → Prise :" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="140" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                              ToolTip="Prise à couper automatiquement quand le safety monitor devient UNSAFE"/>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <!--
      Variantes "_Mini" pour le MINI-SEQUENCEUR (dock Acquisition/Tools) — INDISPENSABLES
      pour chaque entite : sans cle "_Mini", le MiniSequencerDataTemplateSelector retourne
      null et le fallback implicite (DataType) rend la SequenceBlockView COMPLETE —
      une carte qui prend 75% de la largeur du dock. Cles : FullName + "_Mini".
    -->
    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerWaitInstruction_Mini">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="WAIT" FontWeight="Bold" Foreground="#FFFFB74D"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox MinWidth="110" VerticalAlignment="Center"
                      ItemsSource="{Binding PlugNames}"
                      SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"/>
            <ComboBox Width="70" VerticalAlignment="Center" Margin="6,0,0,0"
                      SelectedIndex="{Binding ExpectedOnIndex, Mode=TwoWay}">
                <ComboBoxItem Content="OFF"/>
                <ComboBoxItem Content="ON"/>
            </ComboBox>
            <TextBox Width="45" VerticalAlignment="Center" Margin="6,0,0,0"
                     Text="{Binding TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerToggleInstruction_Mini">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="TGL" FontWeight="Bold" Foreground="#FF4FC3F7"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox MinWidth="110" VerticalAlignment="Center"
                      ItemsSource="{Binding PlugNames}"
                      SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"/>
            <TextBlock Text="min" VerticalAlignment="Center" Margin="6,0,2,0"/>
            <TextBox Width="40" VerticalAlignment="Center"
                     Text="{Binding DurationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerCondition_Mini">
        <mini:MiniCondition>
            <mini:MiniCondition.ConditionProgressContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="WHILE" FontWeight="Bold" Foreground="#FFBA68C8"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox MinWidth="110" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"/>
                    <ComboBox Width="80" VerticalAlignment="Center" Margin="6,0,0,0"
                              SelectedIndex="{Binding ExpectedOnIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="OFF"/>
                        <ComboBoxItem Content="ON"/>
                    </ComboBox>
                </StackPanel>
            </mini:MiniCondition.ConditionProgressContent>
        </mini:MiniCondition>
    </DataTemplate>

    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerUnsafeTrigger_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="⚠" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox MinWidth="110" VerticalAlignment="Center"
                              ItemsSource="{Binding PlugNames}"
                              SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"/>
                </StackPanel>
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerDelayedOffInstruction_Mini">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="OFF-IN" FontWeight="Bold" Foreground="#FFEF5350"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox MinWidth="110" VerticalAlignment="Center"
                      ItemsSource="{Binding PlugNames}"
                      SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"/>
            <TextBlock Text="s" VerticalAlignment="Center" Margin="6,0,2,0"/>
            <TextBox Width="45" VerticalAlignment="Center"
                     Text="{Binding DelaySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>