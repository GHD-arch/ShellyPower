<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sp="clr-namespace:NINA.ShellyPower">

    <!--
      Templates du plugin Shelly Power, compiles en BAML (contenu diffe).
      Charge via PluginResources (export MEF officiel) : NINA fusionne ce dictionnaire
      dans Application.Current.Resources.MergedDictionaries au chargement du plugin.
      Le contenu differe est materialise au premier acces sur le thread UI — ce qui
      evite tous les problemes d'affinite de thread des templates crees en code.
    -->

    <!-- Panneau dockable de la fenetre principale (GenericTemplateSelector : FullName + "_Dockable") -->
    <DataTemplate x:Key="NINA.ShellyPower.ShellyOptionsVM_Dockable">
        <sp:ShellyOptionsView/>
    </DataTemplate>

    <!-- Page Plugins des Options de NINA (PluginOptionsDataTemplateSelector : manifest.Name + suffixe) -->
    <DataTemplate x:Key="Shelly Power_Options">
        <sp:ShellyOptionsView/>
    </DataTemplate>
    <DataTemplate x:Key="Shelly PowerOptions">
        <sp:ShellyOptionsView/>
    </DataTemplate>
    <DataTemplate x:Key="ShellyOptionsVM_Options">
        <sp:ShellyOptionsView/>
    </DataTemplate>

    <!--
      Templates des instructions de sequencer : UNIQUEMENT les cles "_Mini" ici.
      Les templates DataType (implicites) NE sont PAS dans ce dictionnaire — ils seraient
      trouves par l'ItemsControl du sequencer au niveau de la LIGNE ENTIERE (remplaçant
      le SequenceBlockView de NINA avec ses boutons d'action). A la place, les templates
      DataType sont injectes au runtime dans les Resources du ContentPresenter individuel
      (voir ShellyPowerInstructionBase.OnContentPresenterLoaded) — scope element, invisible
      pour l'ItemsControl, mais trouve par le ContentPresenter pour la zone d'edition.
    -->
    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerOnInstruction_Mini">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="ON" FontWeight="Bold" Foreground="#FF66BB6A"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox MinWidth="120" VerticalAlignment="Center"
                      ItemsSource="{Binding PlugNames}"
                      SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                      ToolTip="Prise à piloter (les prises configurées avec une IP apparaissent ici)"/>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NINA.ShellyPower.ShellyPowerOffInstruction_Mini">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="OFF" FontWeight="Bold" Foreground="#FFEF5350"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox MinWidth="120" VerticalAlignment="Center"
                      ItemsSource="{Binding PlugNames}"
                      SelectedIndex="{Binding SelectedPlugIndex, Mode=TwoWay}"
                      ToolTip="Prise à piloter (les prises configurées avec une IP apparaissent ici)"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>